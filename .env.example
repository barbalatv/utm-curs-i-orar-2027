# --- Auto-update -------------------------------------------------------------
# Official schedule page (source of truth; the PDF URL is discovered from it).
SCHEDULE_PAGE_URL=https://fcim.utm.md/procesul-de-studii/orar/
# Check interval in minutes.
SCHEDULE_REFRESH_MINUTES=30
# Course years served by this deployment, comma separated. Each one gets its own
# schedule, source state and history; nothing is merged between them. Validated at
# startup: an empty, padded ("01"), non-numeric, unknown or duplicated entry stops the
# process instead of quietly narrowing the deployment to course 1.
SCHEDULE_COURSES=1,2
# Course an API request without ?course= resolves to (kept at 1 for compatibility).
# Must be one of the courses SCHEDULE_COURSES enables.
SCHEDULE_DEFAULT_COURSE=1
# SCHEDULE_COURSE_YEAR was removed when one deployment began serving several courses.
# It is not ignored: if it is still set, startup fails with a migration message. Replace
# it with SCHEDULE_COURSES (SCHEDULE_COURSE_YEAR=1 becomes SCHEDULE_COURSES=1).

# Monday of a week the university counts as odd ("saptamana impara"), YYYY-MM-DD.
# The autumn 2026/2027 semester opens on Monday 31 August 2026 = week 1. Set this once
# per semester; the app fades out the lessons that belong to the other week.
SCHEDULE_ODD_WEEK_ANCHOR=2026-08-31
# Comma-separated hosts allowed for downloads (SSRF guard).
SCHEDULE_ALLOWED_HOSTS=fcim.utm.md,utm.md
# Use the official WordPress REST representation when the rendered page is blocked.
SCHEDULE_WORDPRESS_FALLBACK=true
# Optional override; by default this URL is derived from SCHEDULE_PAGE_URL.
# SCHEDULE_WORDPRESS_API_URL=https://fcim.utm.md/wp-json/wp/v2/pages?slug=orar&context=view
# Use the public Wayback copy only after both official endpoints fail.
SCHEDULE_WAYBACK_FALLBACK=true
SCHEDULE_HTTP_TIMEOUT_MS=20000
SCHEDULE_MAX_REDIRECTS=5
SCHEDULE_MAX_PDF_MB=25

# --- Storage -----------------------------------------------------------------
# Root of the per-course cache: <dir>/courses/<year>/{current_schedule,metadata}.json.
# A pre-multi-course <dir>/current_schedule.json is adopted once, by the course its
# parsed metadata names (in practice Anul I); the legacy files are left in place.
SCHEDULE_DATA_DIR=data
# The release-managed verified seed needs no SCHEDULE_SEED_* configuration. Advanced
# overrides only: a PDF path or mirror alone relocates the current bundled document and
# must contain the bundled bytes. Changing the provenance URL creates a custom descriptor
# and requires an explicit SHA plus a PDF path and/or mirror. Course 1 uses unsuffixed
# names; every other course appends _<year>.
# SCHEDULE_SEED_PDF=/alternate/path/to/current-bundled-seed.pdf
# SCHEDULE_SEED_PDF_URL=https://publisher.example/custom-seed.pdf
# SCHEDULE_SEED_PDF_MIRROR_URL=https://cdn.example/custom-or-bundled-seed.pdf
# SCHEDULE_SEED_PDF_SHA256=<64-character-sha256>
# Anul II, same advanced overrides with the course year appended.
# SCHEDULE_SEED_PDF_2=/alternate/path/to/current-bundled-seed.pdf
# SCHEDULE_SEED_PDF_URL_2=https://publisher.example/custom-seed.pdf
# SCHEDULE_SEED_PDF_MIRROR_URL_2=https://cdn.example/custom-or-bundled-seed.pdf
# SCHEDULE_SEED_PDF_SHA256_2=<64-character-sha256>
# Optional PostgreSQL history store (leave empty for file-only mode). It is also the
# connection the schema tooling uses: DATABASE_URL=... npm run db:migrate applies the
# checked-in migrations in drizzle/ to this database.
DATABASE_URL=

# --- Broker (Cloudflare Worker + R2) ----------------------------------------
# Base URL for the schedule broker (e.g. https://fcim-schedule-broker.barbalatv.workers.dev).
# Unset or empty = direct FCIM transport.
SCHEDULE_BROKER_URL=
# Bearer secret token for authenticating durable accepted-state writes to the broker.
SCHEDULE_BROKER_SECRET=
# Request timeout in milliseconds for broker reads and accepted writes (default: 3000).
SCHEDULE_BROKER_TIMEOUT_MS=3000

# --- Maintenance -------------------------------------------------------------
# Bearer token for POST /api/admin/refresh (empty = endpoint disabled).
SCHEDULE_ADMIN_TOKEN=
# Set to 1 to disable the background scheduler (tests / build).
SCHEDULE_DISABLE_SCHEDULER=
LOG_LEVEL=info

