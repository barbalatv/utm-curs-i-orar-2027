# --- Auto-update -------------------------------------------------------------
# Official schedule page (source of truth; the PDF URL is discovered from it).
SCHEDULE_PAGE_URL=https://fcim.utm.md/procesul-de-studii/orar/
# Check interval in minutes.
SCHEDULE_REFRESH_MINUTES=30
# Course year served by this deployment (1 = "Anul I").
SCHEDULE_COURSE_YEAR=1
# Comma-separated hosts allowed for downloads (SSRF guard).
SCHEDULE_ALLOWED_HOSTS=fcim.utm.md,utm.md
# Use the official WordPress REST representation when the rendered page is blocked.
SCHEDULE_WORDPRESS_FALLBACK=true
# Optional override; by default this URL is derived from SCHEDULE_PAGE_URL.
# SCHEDULE_WORDPRESS_API_URL=https://fcim.utm.md/wp-json/wp/v2/pages?slug=orar&context=view
# Use the public Wayback copy only after both official endpoints fail.
SCHEDULE_WAYBACK_FALLBACK=true
SCHEDULE_HTTP_TIMEOUT_MS=20000
SCHEDULE_MAX_REDIRECTS=5
SCHEDULE_MAX_PDF_MB=25

# --- Storage -----------------------------------------------------------------
# Directory with current_schedule.json / metadata.json.
SCHEDULE_DATA_DIR=data
# Optional bundled fallback used only when there is no cache and every live source is unavailable.
SCHEDULE_SEED_PDF=data/seed/anul_i_semestrul_i-5.pdf
SCHEDULE_SEED_PDF_URL=https://fcim.utm.md/wp-content/uploads/sites/24/2026/09/anul_i_semestrul_i-5.pdf
# Public byte-for-byte mirror used only if the bundled file is unavailable at runtime.
SCHEDULE_SEED_PDF_MIRROR_URL=https://raw.githubusercontent.com/barbalatv/utm-curs-i-orar-2027/main/data/seed/anul_i_semestrul_i-5.pdf
# Optional PostgreSQL history store (leave empty for file-only mode).
DATABASE_URL=

# --- Maintenance -------------------------------------------------------------
# Bearer token for POST /api/admin/refresh (empty = endpoint disabled).
SCHEDULE_ADMIN_TOKEN=
# Set to 1 to disable the background scheduler (tests / build).
SCHEDULE_DISABLE_SCHEDULER=
LOG_LEVEL=info
