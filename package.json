{
  "name": "fcim-schedule",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "parser": "tsx scripts/parser-cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck:worker": "tsc -p worker/tsconfig.json --noEmit",
    "typecheck:publisher": "tsc -p tools/md-publisher/tsconfig.json --noEmit",
    "check:worker": "wrangler deploy --dry-run --config worker/wrangler.toml",
    "build:publisher": "tsc -p tools/md-publisher/tsconfig.build.json"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "pdfjs-dist": "^6.4.299",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "4.151.0"
  }
}
